# Local development defaults. Do not expose the API to an untrusted network.
APP_NAME=IIHS Media Archive API
APP_ENV=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://archive:archive_local_only@localhost:5433/archive
STORAGE_ROOT=../data/storage
DERIVATIVES_ROOT=../data/derivatives
PEOPLE_ROOT=../data/people
INGEST_ROOTS_JSON=[]
MAX_UPLOAD_MB=512
MAX_WORKERS=2
VIDEO_FRAME_INTERVAL_SECONDS=30
MAX_VIDEO_FRAMES=500
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL_PATH=../models/embeddinggemma
