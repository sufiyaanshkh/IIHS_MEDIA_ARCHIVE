COOKIE_SECURE=false
SESSION_HOURS=8
MAX_FILES_PER_JOB=0
MAX_FILE_BYTES=0
MIN_STORAGE_FREE_BYTES=1073741824
VIDEO_FRAME_INTERVAL_SECONDS=60
VIDEO_FRAME_MAX=5
FACE_FEATURE_ENABLED=false
